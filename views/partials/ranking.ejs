<section class="ranking">
    <h2>November 2026 standouts</h2>
    <p></p>

    <div class="ranking-inner">
        <% games.forEach(g => {  %> 
    <a href="/game/<%= g.id %>">

        <figure class="ranking-inner-ranking <%= (g.metacritic > 95)? 'top': '' %>">
            <img src="<%= g.image %>" alt="<%= g.alt %>">
            <figcaption><%= g.title %> </figcaption>
        </figure>

    </a>

    <% }) %> 
    </div>





</section>